# Copiá esto a .env.local (ignorado por git) y completá con tus datos.
# Sin estas variables la app corre en modo local-first (localStorage + IndexedDB).
# Guía completa: docs/supabase-setup.md

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Email del único admin. El Login sólo pide la contraseña.
VITE_ADMIN_EMAIL=
# Acceso a Web3Forms para el formulario de contacto (pública).
VITE_CONTACT_ACCESS_KEY=
